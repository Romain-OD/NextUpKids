    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!-- Chunky 3D buttons: a hard darker "lip" under the button (zero-blur shadow); pressing sinks it.
         Variants below only swap colors and inherit the pressed/disabled states. -->
    <Style TargetType="Button" x:Key="ChunkyButton">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="NunitoBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Padding" Value="22,10"/>
        <Setter Property="MinimumHeightRequest" Value="56"/>
        <Setter Property="MinimumWidthRequest" Value="56"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource PrimaryLip}" Offset="0,6" Radius="0" Opacity="1" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TranslationY" Value="4" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource InkSoft}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource Swan}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ChunkyButton}" />

    <Style TargetType="Button" x:Key="SkyButton" BasedOn="{StaticResource ChunkyButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Sky}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource SkyLip}" Offset="0,6" Radius="0" Opacity="1" />
        </Setter>
    </Style>

