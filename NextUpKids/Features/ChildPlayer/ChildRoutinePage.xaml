<ContentPage x:Class="NextUpKids.Features.ChildPlayer.ChildRoutinePage"
             xmlns:local="clr-namespace:NextUpKids.Features.ChildPlayer"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="local:ChildRoutineViewModel"
             BackgroundColor="{StaticResource Cloud}" Shell.NavBarIsVisible="False">
    <ContentPage.Triggers>
        <DataTrigger TargetType="ContentPage" Binding="{Binding IsDimmed}" Value="True">
            <Setter Property="BackgroundColor" Value="{StaticResource Night}" />
        </DataTrigger>
    </ContentPage.Triggers>
    <Grid>
        <!-- Filou is the star: he fills the left half and acts out the step (tap him when done).
             The right half holds the title, timer and buttons. -->
        <Grid x:Name="FrameContent" Padding="28,14" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12"
              ColumnDefinitions="1.1*,*" ColumnSpacing="24">
            <ContentView x:Name="Stage" Grid.RowSpan="4" Margin="0,40,0,0" AutomationId="Buddy"
                         SemanticProperties.Description="{Binding Title}"
                         SemanticProperties.Hint="Toucher pour terminer cette étape">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DoneCommand}" />
                </ContentView.GestureRecognizers>
                <local:FoxBuddyView x:Name="Buddy" />
            </ContentView>
            <Label Grid.Column="1" Text="{Binding Title}" FontSize="34" FontFamily="NunitoBold" VerticalOptions="Center"
                   HorizontalTextAlignment="Center" Margin="0,0,112,0"
                   AutomationId="RoutineTitle">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsDimmed}" Value="True">
                        <Setter Property="TextColor" Value="#E4DEFA" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border Grid.Column="1" HorizontalOptions="End" VerticalOptions="Start" BackgroundColor="{StaticResource White}"
                    StrokeShape="RoundRectangle 24" Padding="16,4" x:Name="StarBadge" AutomationId="StarBadge"
                    SemanticProperties.Description="{Binding Stars, StringFormat='{0} étoiles'}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.18" />
                </Border.Shadow>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="★" FontSize="28" TextColor="{StaticResource SunLip}" VerticalOptions="Center" />
                    <Label Text="{Binding Stars}" FontSize="26" FontFamily="NunitoBold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <!-- A picture card only appears for steps Filou cannot act out, such as a parent's photo. -->
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <local:TimerRingView x:Name="Timer" Grid.ColumnSpan="2" Fraction="{Binding TimerFraction}" Text="{Binding TimerText}"
                                 IsVisible="{Binding HasTimer}" Margin="8,24" AutomationId="StepTimer" />
            <Border x:Name="StepCard" BackgroundColor="{StaticResource White}" IsVisible="False"
                    StrokeShape="RoundRectangle 32" Padding="12" HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,8" Radius="24" Opacity="0.16" />
                </Border.Shadow>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsDimmed}" Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Border.Triggers>
                <ImageButton Source="{Binding Image}" Aspect="AspectFit" BackgroundColor="Transparent"
                             Command="{Binding DoneCommand}" AutomationId="RoutineImage"
                             SemanticProperties.Description="{Binding Title}"
                             SemanticProperties.Hint="Toucher pour terminer cette étape" />
            </Border>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="70,*,70" ColumnSpacing="12">
                <ImageButton Source="speaker.png" Command="{Binding ReplayCommand}" HeightRequest="66"
                             BackgroundColor="{StaticResource PrimaryGlass}" BorderColor="{StaticResource GlassRim}" BorderWidth="2"
                             CornerRadius="33" Padding="12" AutomationId="ReplayButton"
                             SemanticProperties.Description="Répéter / Repeat">
                    <ImageButton.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="18" Opacity="0.25" />
                    </ImageButton.Shadow>
                </ImageButton>
                <Button Grid.Column="1" Text="{Binding DoneText}" Command="{Binding DoneCommand}"
                        IsVisible="{Binding HasStep}" FontSize="28" CornerRadius="38" HeightRequest="76" Style="{StaticResource GlassButton}"
                        AutomationId="DoneButton" />
                <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" HorizontalOptions="Center" Spacing="12" IsVisible="{Binding ShowRewards}"
                                       BindableLayout.ItemsSource="{Binding Rewards}" AutomationId="Rewards">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:RewardOption">
                            <Button Text="{Binding Text}" IsEnabled="{Binding Affordable}" FontSize="22" CornerRadius="38" HeightRequest="76"
                                    Style="{StaticResource GlassSunButton}"
                                    Command="{Binding RedeemCommand, Source={RelativeSource AncestorType={x:Type local:ChildRoutineViewModel}}, x:DataType=local:ChildRoutineViewModel}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
                <Border Grid.Column="2" BackgroundColor="{StaticResource White}" IsVisible="{Binding HasStep}"
                        StrokeShape="RoundRectangle 26" HeightRequest="52" Padding="4,0" VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.18" />
                    </Border.Shadow>
                    <Label Text="{Binding Progress}" FontSize="22" FontFamily="NunitoBold" TextColor="{StaticResource Primary}"
                           VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                </Border>
            </Grid>
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Error}" FontSize="15" TextColor="{StaticResource ErrorText}"
                   HorizontalTextAlignment="Center" />
        </Grid>
        <local:SparkleView x:Name="Sparkles" InputTransparent="True" />
        <Border WidthRequest="48" HeightRequest="48" HorizontalOptions="Start" VerticalOptions="Start"
                BackgroundColor="Transparent" StrokeThickness="0" AutomationId="ParentCorner"
                SemanticProperties.Description="Parents : maintenir trois secondes">
            <Border.Behaviors>
                <toolkit:TouchBehavior x:Name="ParentHold" LongPressDuration="3000"
                                       LongPressCommand="{Binding RequestParentAccessCommand}" />
            </Border.Behaviors>
            <Label Text="•••" TextColor="{StaticResource InkSoft}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>