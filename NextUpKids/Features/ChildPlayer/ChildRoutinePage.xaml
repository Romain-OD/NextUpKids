<ContentPage x:Class="NextUpKids.Features.ChildPlayer.ChildRoutinePage"
             xmlns:local="clr-namespace:NextUpKids.Features.ChildPlayer"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="local:ChildRoutineViewModel"
             BackgroundColor="#EFF8FC" Shell.NavBarIsVisible="False">
    <ContentPage.Triggers>
        <DataTrigger TargetType="ContentPage" Binding="{Binding IsDimmed}" Value="True">
            <Setter Property="BackgroundColor" Value="#17243B" />
        </DataTrigger>
    </ContentPage.Triggers>
    <Grid>
        <Grid x:Name="FrameContent" Padding="28,16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
            <Label Text="{Binding Title}" FontFamily="Nunito" FontSize="38" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" TextColor="#17243B" Margin="58,0"
                   AutomationId="RoutineTitle">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsDimmed}" Value="True">
                        <Setter Property="TextColor" Value="#D8DDED" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <ImageButton Grid.Row="1" Source="{Binding Image}" Aspect="AspectFit" BackgroundColor="Transparent"
                         Command="{Binding DoneCommand}" AutomationId="RoutineImage"
                         SemanticProperties.Description="{Binding Title}"
                         SemanticProperties.Hint="Toucher pour terminer cette étape">
                <ImageButton.Triggers>
                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsDimmed}" Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>
            <Grid Grid.Row="2" ColumnDefinitions="90,*,90" ColumnSpacing="18">
                <ImageButton Source="speaker.png" Command="{Binding ReplayCommand}" HeightRequest="70"
                             BackgroundColor="#D6EAF1" CornerRadius="24" Padding="12" AutomationId="ReplayButton"
                             SemanticProperties.Description="Répéter / Repeat" />
                <Button Grid.Column="1" Text="{Binding DoneText}" Command="{Binding DoneCommand}"
                        IsVisible="{Binding HasStep}" FontFamily="Nunito" FontSize="30" FontAttributes="Bold"
                        CornerRadius="28" BackgroundColor="#176B57" TextColor="White" HeightRequest="76"
                        AutomationId="DoneButton" />
                <Label Grid.Column="2" Text="{Binding Progress}" FontFamily="Nunito" FontSize="22"
                       TextColor="#52718A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
            </Grid>
            <Label Grid.Row="3" Text="{Binding Error}" FontSize="14" TextColor="#B04735"
                   HorizontalTextAlignment="Center" />
        </Grid>
        <local:SparkleView IsActive="{Binding IsCelebrating}" InputTransparent="True" />
        <Border WidthRequest="48" HeightRequest="48" HorizontalOptions="Start" VerticalOptions="Start"
                BackgroundColor="Transparent" StrokeThickness="0" AutomationId="ParentCorner"
                SemanticProperties.Description="Parents : maintenir trois secondes">
            <Border.Behaviors>
                <toolkit:TouchBehavior x:Name="ParentHold" LongPressDuration="3000"
                                       LongPressCommand="{Binding RequestParentAccessCommand}" />
            </Border.Behaviors>
            <Label Text="•••" TextColor="#678499" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
