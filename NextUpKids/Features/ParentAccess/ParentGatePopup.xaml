<toolkit:Popup x:Class="NextUpKids.Features.ParentAccess.ParentGatePopup"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:local="clr-namespace:NextUpKids.Features.ParentAccess"
               x:TypeArguments="x:Boolean" x:DataType="local:ParentGateViewModel">
    <!-- Compact so it fits a landscape phone (~360 dp tall), not just a tablet. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="12"
          Padding="16,8" WidthRequest="440" BackgroundColor="White">
        <Label Grid.ColumnSpan="2" Text="Espace parents" FontSize="22" FontFamily="NunitoBold" />
        <Label Grid.Row="1" Text="{Binding Challenge}" FontSize="26" FontFamily="NunitoBold" VerticalOptions="Center"
               AutomationId="ParentChallenge" />
        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Answer}" Keyboard="Numeric" MaxLength="4" Placeholder="Réponse"
               ReturnType="Done" Completed="OnSubmit" AutomationId="ParentAnswer"
               SemanticProperties.Description="Réponse au calcul" />
        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Error}" TextColor="{StaticResource ErrorText}" />
        <Button Grid.Row="3" Text="Annuler" Style="{StaticResource QuietButton}" Clicked="OnCancel" />
        <Button Grid.Row="3" Grid.Column="1" Text="Ouvrir" Clicked="OnSubmit" AutomationId="UnlockButton" />
    </Grid>
</toolkit:Popup>
