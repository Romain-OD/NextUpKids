<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net11.0 = plain library build consumed by NextUpKids.Tests (no device needed). -->
		<TargetFrameworks>net11.0-android;net11.0</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios</TargetFrameworks>
		<OutputType Condition="'$(TargetFramework)' != 'net11.0'">Exe</OutputType>
		<RootNamespace>NextUpKids</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<WarningsAsErrors>$(WarningsAsErrors);XC0022;XC0023;XC0024;XC0025</WarningsAsErrors>

		<ApplicationTitle>NextUpKids</ApplicationTitle>
		<ApplicationId>com.nextupkids.app</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Common\Resources\AppIcon\appicon.svg" ForegroundFile="Common\Resources\AppIcon\appiconfg.svg" ForegroundScale="0.8" Color="#7357E8" />
		<MauiSplashScreen Include="Common\Resources\Splash\splash.svg" Color="#7357E8" BaseSize="128,128" />
		<MauiImage Include="Common\Resources\Images\*.svg" BaseSize="512,512" />
		<MauiFont Include="Common\Resources\Fonts\*.ttf" />
		<MauiAsset Include="Common\Resources\Images\*.txt;Common\Resources\Fonts\*.txt" LogicalName="Licenses/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

</Project>
